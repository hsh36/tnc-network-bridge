{
  "name": "tnc-network-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "SMB protocol bridge connecting SMB 1.0-only HEIDENHAIN TNC machines to modern SMB 3.1.1+ servers",
  "main": "dist/backend/index.js",
  "license": "GPL-3.0-or-later",
  "author": "TNC Network Bridge Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsh36/tnc-network-bridge.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "smb",
    "cifs",
    "samba",
    "heidenhain",
    "tnc",
    "cnc",
    "file-sync",
    "raspberry-pi"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "tsc -b src/shared/tsconfig.json",
    "build:backend": "npm run build:shared && tsc -p src/backend/tsconfig.json && node scripts/copy-assets.mjs",
    "build:frontend": "npm run build:shared && vite build",
    "type-check": "npm run build:shared && tsc -p src/backend/tsconfig.json --noEmit && tsc -p src/frontend/tsconfig.json --noEmit && tsc -p tsconfig.jest.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:sync": "jest src/backend/sync --passWithNoTests",
    "test:smb": "jest src/backend/smb --passWithNoTests",
    "test:web": "jest src/backend/web --passWithNoTests",
    "test:frontend": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('coverage',{recursive:true,force:true})\"",
    "prepare": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "cookie-parser": "^1.4.7",
    "croner": "^8.1.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "handlebars": "^4.7.8",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.1.0",
    "p-limit": "^3.1.0",
    "picomatch": "^4.0.2",
    "pino": "^9.6.0",
    "pino-roll": "^3.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/picomatch": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "jest": "^29.7.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vitest": "^3.0.8"
  }
}
